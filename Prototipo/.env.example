# Copie para .env e preencha as credenciais somente no servidor.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Agente próprio cadastrado no portal de desenvolvedores iFood.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_SCOPES="mcp.user.basic.read mcp.user.addresses.read mcp.user.addresses.write mcp.discovery.search.read mcp.discovery.browse.read mcp.discovery.details.read mcp.cart.read mcp.cart.write mcp.cart.payment mcp.cart.checkout mcp.orders.read"
IFOOD_REDIRECT_URI=http://localhost:3000/api/auth/ifood/callback
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace

# Caminho relativo à pasta Prototipo; crie o venv na raiz do projeto.
PYTHON_BIN=../.venv/bin/python
PORT=3000
HOST=127.0.0.1
# DATABASE_PATH=./data/viu-pediu.sqlite
